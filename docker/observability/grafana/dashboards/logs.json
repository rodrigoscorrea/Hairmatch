          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "service_name",
          "refId": "service",
          "stream": "",
          "type": 1
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "regex": "",
        "hide": 0,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "level",
        "label": "Nível",
        "type": "custom",
        "query": "trace,debug,info,warn,error,fatal,unknown",
