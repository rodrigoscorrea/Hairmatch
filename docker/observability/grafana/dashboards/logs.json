          },
          {
            "selected": false,
            "text": "error",
            "value": "error"
          },
          {
            "selected": false,
            "text": "fatal",
            "value": "fatal"
          },
          {
            "selected": false,
            "text": "unknown",
            "value": "unknown"
          }
        ],
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
