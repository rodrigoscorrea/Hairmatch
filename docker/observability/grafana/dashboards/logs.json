{
  "uid": "logs",
  "title": "Logs",
  "tags": [
    "hairmatch",
    "loki"
  ],
  "description": "Logs do Loki: backend (hairmatch-api) e browser (Faro), já com dados pessoais mascarados pelo Collector.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
