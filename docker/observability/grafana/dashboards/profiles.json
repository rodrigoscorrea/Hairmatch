{
  "uid": "profiles",
  "title": "Profiles",
  "tags": [
    "hairmatch",
    "pyroscope"
  ],
  "description": "Profiling contínuo do backend (Pyroscope). O SDK liga com PYROSCOPE_SERVER_ADDRESS.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "profile_type",
        "label": "Tipo de profile",
        "type": "query",
        "datasource": {
          "type": "grafana-pyroscope-datasource",
          "uid": "pyroscope"
        },
        "query": {
          "type": "profileType",
          "refId": "profile_type"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "service",
        "label": "Serviço",
        "type": "query",
        "datasource": {
          "type": "grafana-pyroscope-datasource",
          "uid": "pyroscope"
        },
        "query": {
          "type": "labelValue",
          "profileTypeId": "$profile_type",
          "labelName": "service_name",
          "refId": "service"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "Sem dados? O backend só envia profiles com `PYROSCOPE_SERVER_ADDRESS=http://pyroscope:4040` em `docker/.env` (veja `docs/observability/README.md`). O flame graph mostra o tempo de CPU por função do processo Django."
      },
      "id": 1,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "CPU",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 3
      }
    },
    {
      "type": "timeseries",
      "title": "Amostras de profile ao longo do tempo",
      "description": "",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "pyroscope"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-pyroscope-datasource",
            "uid": "pyroscope"
          },
          "queryType": "metrics",
          "profileTypeId": "$profile_type",
          "labelSelector": "{service_name=\"$service\"}",
          "groupBy": [
            "service_name"
          ]
        }
      ],
      "id": 3,
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 4
      }
    },
    {
      "type": "flamegraph",
      "title": "Flame graph",
      "description": "Clique numa função para aprofundar; a tabela lateral ordena por tempo próprio.",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "pyroscope"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-pyroscope-datasource",
            "uid": "pyroscope"
          },
          "queryType": "profile",
          "profileTypeId": "$profile_type",
          "labelSelector": "{service_name=\"$service\"}",
          "groupBy": [],
          "maxNodes": 16384
        }
      ],
      "id": 4,
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 11
      }
    }
  ],
  "links": [
    {
      "title": "Dashboards",
      "type": "dashboards",
      "tags": [
        "hairmatch"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ]
}
