POSTGRES_DB=hairmatch
POSTGRES_USER=hairmatch
POSTGRES_PASSWORD=hairmatch

DB_HOST=localhost
DB_NAME=hairmatch
DB_USER=hairmatch
DB_PASSWORD=hairmatch

GEMINI_API_KEY=

SERVER_TYPE=http
SERVER_PORT=8080

SERVER_URL=http://localhost:8080

CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true

CONFIG_SESSION_PHONE_CLIENT=Hairmatch
CONFIG_SESSION_PHONE_NAME=Chrome

DATABASE_ENABLED=false
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://hairmatch:hairmatch@localhost:5432/evolution
DATABASE_CONNECTION_CLIENT_NAME=evolution
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true

CACHE_REDIS_ENABLED=false

LOG_LEVEL=ERROR
LOG_COLOR=true
LOG_BAILEYS=error

CONFIG_SESSION_PHONE_VERSION=2.3000.1023204200
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me-evolution-api-key
EVOLUTION_INSTANCE_NAME=hairmatch
AUTHENTICATION_API_KEY=change-me-evolution-api-key

BACKEND_ALLOWED_HOST=localhost
BACKEND_ALLOWED_CORS=http://localhost:8081
# Proxies in front of Django, used to read the client IP for rate limits. 0 in dev; 1 behind Render.
BACKEND_NUM_PROXIES=0

GOOGLE_OAUTH_CLIENT_IDS=

#Localstack
LOCALSTACK_AUTH_TOKEN=
LOCALSTACK_IMAGE_TAG=latest
LOCALSTACK_DEBUG=0
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET_NAME=dev-hairmatch-media
SES_SENDER_EMAIL=no-reply@hairmatch.local

# Cognito (MiniStack). Leave both empty in dev: the backend finds the hairmatch-dev pool and the
# hairmatch-backend client by name. In production, set the real user pool and app client IDs.
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
